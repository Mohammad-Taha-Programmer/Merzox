NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/merzox
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
PUBLIC_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Merzox <your-email@gmail.com>"
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Firebase Admin push is opt-in. Keep private credentials outside this repository.
# When enabled outside Google-hosted environments, provide credentials through
# GOOGLE_APPLICATION_CREDENTIALS in the process environment.
FIREBASE_PUSH_ENABLED=false

# Production configuration contract:
# - Set NODE_ENV=production explicitly.
# - JWT_SECRET must be a random secret of at least 32 characters.
# - PUBLIC_BASE_URL must be an explicit HTTPS origin.
# - Production CORS_ORIGINS entries, when present, must be exact HTTPS origins;
#   wildcard origins are development-only.
# - SMTP_HOST, SMTP_USER, SMTP_PASS, and SMTP_FROM are required in production.
# - PORT and SMTP_PORT must be integers from 1 through 65535.
# - RATE_LIMIT_WINDOW_MS and RATE_LIMIT_MAX must be positive integers.
# - Boolean settings accept only the literal values true or false.

# HTTP parser and keep-alive policy.
# Values ending in _MS are milliseconds; the remaining values are counts.
# HEADERS timeout must not exceed REQUEST timeout.
# The connection-check interval must not exceed the HEADERS timeout.
# The generic Node server.timeout remains disabled because Socket.IO shares
# this HTTP server and owns liveness for its long-lived transports.
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_CONNECTIONS_CHECKING_INTERVAL_MS=5000
HTTP_MAX_HEADERS_COUNT=100
HTTP_MAX_REQUESTS_PER_SOCKET=1000

# Reverse proxy trust is disabled by default.
# If the API is reachable only through known reverse proxies/load balancers,
# list only their direct source IP addresses or CIDR ranges here.
# Do not use booleans, hop counts, hostnames, or a catch-all trust policy.
TRUST_PROXY_RANGES=
