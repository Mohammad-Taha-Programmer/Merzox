<component name="ProjectRunConfigurationManager">
  <!--
    Runs the app against the API named in config/merzox.dev.json.

    Android Studio builds its own command line from the run configuration, so
    a flag typed at a terminal never reaches a build started with the Run
    button. Pressing Run with the auto-created "main.dart" configuration
    produces a build with no MERZOX_API_BASE_URL, which falls back to
    10.0.2.2 - the emulator's alias for its host's loopback, and nothing at
    all on a physical device.

    Generate the file first:  dart run tool/dev_config.dart
  -->
  <configuration
      default="false"
      name="merzox (dev API)"
      type="FlutterRunConfigurationType"
      factoryName="Flutter">
    <option name="filePath" value="$PROJECT_DIR$/lib/main.dart" />
    <option name="additionalArgs" value="--dart-define-from-file=config/merzox.dev.json" />
    <method v="2" />
  </configuration>
</component>
